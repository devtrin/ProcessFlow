# ProcessFlow backend configuration. Copy to backend/.env and edit.
# This file contains NO secrets. Put API keys only in your shell environment or
# in backend/.env (which is git-ignored), never in source control.

# Where SQLite and imported source files are stored. Default:
#   Windows  %LOCALAPPDATA%\ProcessFlow
#   macOS    ~/Library/Application Support/ProcessFlow
#   Linux    ~/.local/share/processflow
# PF_DATA_DIR=

# Limits
PF_MAX_UPLOAD_MB=20
PF_MAX_XML_MB=5
PF_MAX_XML_DEPTH=64
PF_MAX_XML_ELEMENTS=50000
PF_MAX_PDF_PAGES=100

# --- PDF process drafting (optional) -------------------------------------
# none (default): PDF text is extracted, but no process is drafted.
# ollama:    local model through Ollama on this machine (no outbound data).
# anthropic: Claude via the Anthropic API (REMOTE: PDF text leaves this machine).
PF_INFERENCE_PROVIDER=none

# Must be true before any remote provider (anthropic, or a non-local Ollama URL)
# is used. The UI additionally asks for confirmation on each drafting request.
PF_ALLOW_REMOTE_INFERENCE=false

# Ollama (local-first)
PF_OLLAMA_BASE_URL=http://127.0.0.1:11434
PF_OLLAMA_MODEL=

# Anthropic. The key is read from ANTHROPIC_API_KEY in the environment.
PF_ANTHROPIC_MODEL=claude-opus-5-5
PF_ANTHROPIC_EFFORT=high
# "default" enables server-side refusal fallbacks; "off" disables them.
PF_ANTHROPIC_FALLBACKS=default
# ANTHROPIC_API_KEY=   <- set in your shell, not here, if you can avoid it

PF_INFERENCE_TIMEOUT_S=300
PF_LOG_LEVEL=INFO
